# .env.example - Copy to .env and configure for your environment
# Database connection string
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./postureai.db
# MySQL Production format:
# DATABASE_URL=mysql+aiomysql://<username>:<password>@<host>:3306/<database_name>

# Cryptographic Secret Key for session cookie signing (generate a strong random secret)
SECRET_KEY=your_generated_secret_key_here
